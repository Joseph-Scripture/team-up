# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ─── Environment variables ───────────────────────────────────────────────────
# Never commit real secrets. .env.example (no secrets) IS committed.
.env
.env.*
!.env.example

# ─── Prisma generated client ─────────────────────────────────────────────────
# Prisma 7 writes the client into src/generated/prisma by default.
src/generated/

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS / editor artefacts ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ─── IDE config (personal preference — not project config) ───────────────────
.idea/
.vscode/

# ─── Test / coverage output ──────────────────────────────────────────────────
coverage/
tmp/
dist/

# ─── AI agent tooling ────────────────────────────────────────────────────────
# These directories are managed by IDE AI assistants and are not source code.
.agents/
.claude/
.windsurf/
.kilo/
skills-lock.json

# ─── Local dev / scratch files ───────────────────────────────────────────────
# CORS browser test page — useful locally, not part of the application.
cors-test/

# HTTP request scratch files — contain tokens; never commit.
**/*.http
**/*.rest

# DB schema diagram — kept locally, not needed in CI.
db.excalidraw

# Reference documents dropped into the repo root during development.
*.docx
*.pdf
*.xlsx
prisma/seed-dashboard-test.js
prisma/seed.js