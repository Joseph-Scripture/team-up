# PostgreSQL connection string (required)
# Used by Prisma (prisma7.config.js) and the app (source/db/client.js)
DATABASE_URL=postgres://username:password@localhost:5432/database_name

# Secret for signing/verifying JWT access tokens (required, minimum 32 characters)
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_random_secret_at_least_32_chars_long

# Optional settings (defaults shown)
# PORT=4000
# NODE_ENV=development
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30

# ─── Password reset ───────────────────────────────────────────────────────────
# SMTP connection URL for Nodemailer (required for password-reset emails)
# Format: smtps://username:password@smtp.example.com:465
# For Gmail: smtps://you%40gmail.com:app-password@smtp.gmail.com:465
# For Resend: smtps://resend:YOUR_API_KEY@smtp.resend.com:465
# SMTP_URL=smtps://username:password@smtp.example.com:465

# "From" address shown in password-reset emails (required for password-reset emails)
# EMAIL_FROM="TeamUP <no-reply@example.com>"

# Frontend base URL used to build the reset link in the email
# The reset link will be: FRONTEND_URL/reset-password?token=...
# Defaults to http://localhost:5173 in development
# FRONTEND_URL=https://yourapp.example.com

# How long (minutes) a password-reset link stays valid. Min 5. Default 30.
# PASSWORD_RESET_TTL_MINUTES=30

# ─── Redis (optional) ────────────────────────────────────────────────────────
# Without a URL, the API reads directly from PostgreSQL on every request.
# REDIS_URL=redis://localhost:6379

# ─── Cloudinary (required for file uploads) ──────────────────────────────────
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
