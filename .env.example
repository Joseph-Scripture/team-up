# PostgreSQL connection string (required)
# Used by Prisma (prisma7.config.js) and the app (source/db/client.js)
DATABASE_URL=postgres://username:password@localhost:5432/database_name

# Secret for signing/verifying JWT access tokens (required, minimum 32 characters)
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_random_secret_at_least_32_chars_long

# Optional settings (defaults shown)
# PORT=4000
# NODE_ENV=development
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30

# Redis is optional. With no URL, the API reads directly from PostgreSQL.
# REDIS_URL=redis://localhost:6379

# Required only when direct uploads are enabled.
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
